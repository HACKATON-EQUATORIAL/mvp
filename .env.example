# Copie para .env.local. A chave fica somente no servidor, sem NEXT_PUBLIC_.
# Crie a chave em https://console.groq.com/keys
GROQ_API_KEY=

# Opcional. Modelo principal: whisper-large-v3-turbo ou whisper-large-v3.
# Em 429 (limite do free tier) o outro é tentado automaticamente.
GROQ_STT_MODEL=whisper-large-v3-turbo

# Opcional: hostname(s) do ngrok, sem https:// nem porta, separados por vírgula.
# Necessário ao abrir o servidor de desenvolvimento por um túnel externo.
# Exemplo: seu-tunel.ngrok-free.app
NEXT_DEV_ALLOWED_ORIGINS=

# Backend Python acessível PELO NAVEGADOR, incluindo o prefixo /api/v1.
# No celular, localhost aponta para o celular: use o endereço HTTPS público do backend.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Opcional: URL HTTPS do túnel do backend (inclua /api/v1). Usada só quando o app
# é aberto por um host não local (ex.: front via ngrok); em localhost vale a URL acima.
# Lembre de reiniciar o dev server ao alterar.
NEXT_PUBLIC_API_TUNNEL_URL=

# IA do assistente (LLM e transcrição de voz pela Groq). Desligada se ausente:
# use "on" só onde a IA deve rodar. Sem ela, o assistente usa chips e ajuda local.
NEXT_PUBLIC_ASSISTANT_AI=off

# Interpretação por LLM na Groq (usa a mesma GROQ_API_KEY, somente no servidor).
# Modelo principal: openai/gpt-oss-20b, openai/gpt-oss-120b ou qwen/qwen3.8-27b.
# Em 429 os demais são tentados nessa ordem, cada um com cota própria.
GROQ_LLM_MODEL=openai/gpt-oss-20b
